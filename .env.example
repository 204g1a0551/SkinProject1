# Application Environment Configuration
APP_NAME="AI Skin: Intelligent Skin Diseases Detection"
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Device Configuration: 'auto', 'mps' (Apple Silicon GPU), 'cuda', or 'cpu'
DEVICE=auto

# Model Configuration
MODEL_NAME=mobilenet_v2
MODEL_WEIGHTS_PATH=models/mobilenetv2_skin_disease_best.pth
NUM_CLASSES=7

# Logging
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
